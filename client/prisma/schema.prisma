datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  WORKER
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(CITIZEN)
  ward         String?
  phone        String?
  isActive     Boolean @default(true)

  // Citizen side complaints
  complaints Complaint[] @relation("CitizenComplaints")

  // Worker side assigned complaints
  assignedComplaints Complaint[] @relation("WorkerComplaints")

  notifications Notification[]
  feedbacks     Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id          String  @id @default(cuid())
  title       String
  description String?
  category    String
  ward        String

  status   String @default("Pending")
  priority String @default("Medium")

  imageUrl  String?
  latitude  Float?
  longitude Float?

  userId String?
  user   User?   @relation("CitizenComplaints", fields: [userId], references: [id], onDelete: SetNull)

  assignedWorkerId String?
  assignedWorker   User?   @relation("WorkerComplaints", fields: [assignedWorkerId], references: [id], onDelete: SetNull)

  workCompletedAt   DateTime?
  citizenVerified   Boolean   @default(false)
  citizenVerifiedAt DateTime?

  feedback Feedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id String @id @default(cuid())

  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  citizenId String
  workerId  String?

  rating      Int
  description String?

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  title   String
  message String
  type    String  @default("INFO")
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
