# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartdelhi_db

# JWT Secrets and Expirations
JWT_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d